# Doxygen configuration for the public SSQP C++ API. Build from this directory:
#
#     doxygen Doxyfile
#     python3 cpp_reference.py api/xml docs/cpp-reference/ssqp
#
# Doxygen only writes XML, which the second step turns into the reference pages of the site.

PROJECT_NAME           = "SSQP"
OUTPUT_DIRECTORY       = api
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ..
STRIP_FROM_INC_PATH    = ../include
CASE_SENSE_NAMES       = YES

INPUT                  = ../include
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES

# Hides protected and private members, and turns the headers' $...$ math into Doxygen formulas
FILTER_PATTERNS        = *.hpp="python3 doxygen_filter.py"

MARKDOWN_SUPPORT       = YES
MARKDOWN_ID_STYLE      = GITHUB
# Do not infer links from ordinary prose and code paths
AUTOLINK_SUPPORT       = NO
BUILTIN_STL_SUPPORT    = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES
INHERIT_DOCS           = YES

# The public API, including classes and members without doc comments
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SHOW_INCLUDE_FILES     = YES
REFERENCES_RELATION    = NO
REFERENCES_LINK_SOURCE = NO

GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
HAVE_DOT               = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_LOGFILE           = api/doxygen-warnings.log
WARN_AS_ERROR          = NO
